{
    "name": "homs1987/workoutcalendar",
    "description": "Trägt Garmin-Connect-Aktivitäten als Termine in einen Nextcloud-Kalender ein",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "nextcloud/ocp": "^33.0",
        "phpunit/phpunit": "^11.5",
        "psr/log": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "OCA\\WorkoutCalendar\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OCA\\WorkoutCalendar\\Tests\\": "tests/",
            "OCP\\": "vendor/nextcloud/ocp/OCP/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "test:integration": "phpunit -c phpunit.integration.xml"
    }
}
